{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nextzhou/opencode-tps",
  "version": "0.2.0",
  "description": "Display request-level session and per-model TPS metrics in the OpenCode TUI sidebar.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "author": "nextzhou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextzhou/opencode-tps.git"
  },
  "homepage": "https://github.com/nextzhou/opencode-tps#readme",
  "bugs": {
    "url": "https://github.com/nextzhou/opencode-tps/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "tokens-per-second",
    "tps"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "engines": {
    "opencode": ">=1.18.0 <2"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "clean": "bun scripts/clean.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src tests scripts",
    "lint:fix": "oxlint --fix src tests scripts",
    "pack:check": "bun run check && bun scripts/pack-check.ts",
    "prepack": "bun run check",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0 <2",
    "@opentui/core": ">=0.4.5 <1"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.15",
    "@opencode-ai/sdk": "1.18.15",
    "@opentui/core": "0.4.5",
    "@types/bun": "1.3.14",
    "oxlint": "1.79.0",
    "prettier": "3.6.2",
    "typescript": "5.8.2"
  }
}
